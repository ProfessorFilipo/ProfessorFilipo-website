# Copy to backend/.env (gitignored) and fill in the real values.
# Never commit .env with real credentials.

# Neon (Postgres)
DATABASE_URL=postgresql://user:password@ep-xxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=filipomor-site-media
R2_ENDPOINT_URL=

# Environment
APP_ENV=local
APP_DEBUG=true

# Locales
DEFAULT_LOCALE=pt-BR
AVAILABLE_LOCALES=pt-BR,en-CA

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://filipomor.com

# Cloudflare Turnstile (contact form captcha) — Secret Key from the Turnstile dashboard
TURNSTILE_SECRET_KEY=

# Resend (transactional email for the contact form)
RESEND_API_KEY=
CONTACT_EMAIL_TO=filipo.mor@gmail.com
CONTACT_EMAIL_FROM=contato@filipomor.com
